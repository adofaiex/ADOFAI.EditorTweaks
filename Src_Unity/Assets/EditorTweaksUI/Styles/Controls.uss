/* 设置行和里面的控件：选项按钮、滑块、数值框、步进器。方正扁平，照 ADOUAC。 */

.st-row {
    position: relative;
    flex-direction: row;
    align-items: center;
    min-height: 74px;
    max-height: 150px;
    padding: 12px 22px 12px 20px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.05);
    overflow: hidden;
    transition-property: background-color, opacity, translate, max-height, min-height, padding-top, padding-bottom, margin-bottom;
    transition-duration: 0.15s, 0.4s, 0.5s, 0.5s, 0.5s, 0.5s, 0.5s, 0.5s;
    transition-timing-function: ease-out, ease-out, ease-out-cubic, ease-in-out-cubic, ease-in-out-cubic, ease-in-out-cubic, ease-in-out-cubic, ease-in-out-cubic;
}
.st-row.sub { margin-left: 30px; }
.st-row.selected { background-color: rgba(255, 255, 255, 0.10); }
.st-row.hidden { opacity: 0; translate: 0 20px; }
.st-row.collapsed {
    max-height: 0;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
    opacity: 0;
}

/* 左边的红线：选中时淡入并从中间拉长 */
.st-row-bar {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background-color: #FF4B3A;
    opacity: 0;
    scale: 1 0.2;
    transition-property: opacity, scale;
    transition-duration: 0.2s, 0.35s;
    transition-timing-function: ease-out, ease-out-cubic;
}
.st-row.selected .st-row-bar { opacity: 1; scale: 1 1; }

.st-row-icon { margin-right: 18px; -unity-background-image-tint-color: rgba(243, 241, 236, 0.42); }
.st-row.selected .st-row-icon { -unity-background-image-tint-color: #F3F1EC; scale: 1.1 1.1; }

.st-labels { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: 24px; }
.st-label { font-size: 24px; white-space: normal; }
.st-hint-text { font-size: 16px; color: rgba(243, 241, 236, 0.36); margin-top: 2px; white-space: normal; }
.st-control { flex-direction: row; align-items: center; flex-shrink: 0; }

/* ---------------------------------------------------------------- 选项按钮（开 | 关） */

.st-choices { position: relative; flex-direction: row; height: 44px; }
.st-choice {
    width: 96px; height: 44px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    transition-property: background-color;
    transition-duration: 0.15s;
}
.st-choice:hover { background-color: rgba(255, 255, 255, 0.15); }
.st-choice > Label { font-size: 22px; color: rgba(243, 241, 236, 0.62); transition-property: color; transition-duration: 0.2s; }
.st-choice.on > Label { color: #F3F1EC; }
/* 选中的那块高亮：垫在按钮下面，换选项时滑过去 */
.st-choice-hl {
    position: absolute;
    left: 6px; top: 0;
    width: 96px; height: 44px;
    background-color: rgba(255, 255, 255, 0.30);
    transition-property: left;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}
.st-choice-hl.no-anim { transition-duration: 0s; }

/* ---------------------------------------------------------------- 滑块：细线 + 菱形 */

.sl { width: 270px; flex-shrink: 0; }
.sl-hit { height: 44px; justify-content: center; }
.sl-rail { position: absolute; left: 14px; right: 14px; top: 0; bottom: 0; }
.sl-track {
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 3px;
    margin-top: -1px;
    background-color: rgba(255, 255, 255, 0.35);
}
.sl-thumb {
    position: absolute;
    left: 0; top: 50%;
    width: 16px; height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    rotate: 45deg;
    background-color: #F3F1EC;
    transition-property: scale, background-color;
    transition-duration: 0.3s, 0.2s;
    transition-timing-function: ease-out-back, ease-out;
}
.st-row.selected .sl-thumb { background-color: #FF4B3A; }
.sl.hover .sl-thumb { scale: 1.3 1.3; }
.sl.dragging .sl-thumb { scale: 1.6 1.6; }

/* ---------------------------------------------------------------- 数值框 */

.st-value {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 44px;
    margin-left: 24px;
    padding: 0 12px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0.08);
    transition-property: background-color, border-color;
    transition-duration: 0.2s, 0.2s;
}
.st-value:hover { background-color: rgba(255, 255, 255, 0.13); }
.st-value.editing { border-color: #FF4B3A; background-color: rgba(255, 255, 255, 0.14); }
.st-value-field { flex-grow: 1; margin: 0; min-width: 60px; }
.st-value-field .unity-base-text-field__input,
.st-value-field .unity-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    font-size: 22px;
    color: #F3F1EC;
}
.st-value-unit { font-size: 14px; color: rgba(243, 241, 236, 0.36); margin-left: 6px; }

/* ---------------------------------------------------------------- 步进器：← 值 → */

.stp { flex-direction: row; align-items: center; }
.stp-btn {
    width: 52px; height: 44px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    transition-property: background-color, opacity, scale;
    transition-duration: 0.15s, 0.2s, 0.25s;
    transition-timing-function: ease-out, ease-out, ease-out-back;
}
.stp-btn:hover { background-color: rgba(255, 255, 255, 0.20); }
.stp-btn:active { scale: 0.92 0.92; }
.stp-btn .ic { -unity-background-image-tint-color: #F3F1EC; }
.stp-btn.off { opacity: 0.3; }
.stp-view {
    width: 190px; height: 44px;
    margin: 0 6px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.05);
}
.stp-value {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 44px;
    -unity-text-align: middle-center;
    font-size: 22px;
}

/* ---------------------------------------------------------------- 动作按钮（多人页：创建 / 邀请 / 选择…） */

.st-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    height: 44px;
    padding: 0 20px;
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(243, 241, 236, 0.22);
    background-color: rgba(255, 255, 255, 0.06);
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.15s, 0.15s, 0.25s, 0.2s;
    transition-timing-function: ease-out, ease-out, ease-out-back, ease-out;
}
.st-btn > Label { font-size: 21px; color: #F3F1EC; transition-property: color; transition-duration: 0.15s; }
.st-btn .ic { margin-right: 10px; -unity-background-image-tint-color: rgba(243, 241, 236, 0.8); }
.st-btn:hover { background-color: rgba(255, 255, 255, 0.16); }
.st-btn:active { scale: 0.95 0.95; }
.st-btn.primary { background-color: rgba(255, 255, 255, 0.92); border-color: rgba(255, 255, 255, 0.4); }
.st-btn.primary > Label { color: #07080D; }
.st-btn.primary .ic { -unity-background-image-tint-color: #07080D; }
.st-btn.primary:hover { background-color: #FF4B3A; border-color: #FF4B3A; }
.st-btn.primary:hover > Label { color: #F3F1EC; }
.st-btn.primary:hover .ic { -unity-background-image-tint-color: #F3F1EC; }
.st-btn.off { opacity: 0.3; }
.st-row.selected .st-btn.primary { border-color: #FF4B3A; }

/* 只读信息行右边的文字（状态、进度） */
.st-info {
    font-size: 21px;
    color: rgba(243, 241, 236, 0.8);
    -unity-text-align: middle-right;
    max-width: 520px;
    white-space: normal;
}
.st-info.good { color: #6FE3A0; }
.st-info.warn { color: #FF4B3A; }

/* 进度条（文件传输） */
.st-progress { width: 270px; height: 6px; margin-left: 16px; background-color: rgba(255, 255, 255, 0.10); overflow: hidden; }
.st-progress-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: #FF4B3A; transition-property: width; transition-duration: 0.25s; transition-timing-function: ease-out; }

/* ---------------------------------------------------------------- 平滑滚动的滚动条（Src/UI/SmoothScroll.cs，替代 Unity 自带的） */

/* 整条是 14px 宽的点击区，里面的滑块平时 4px 细线，悬停 / 拖动时变 8px */
.ss-bar {
    position: absolute;
    right: 4px; top: 8px; bottom: 8px;
    width: 14px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.ss-bar.off { opacity: 0; }
.ss-thumb {
    position: absolute;
    right: 3px;
    width: 4px;
    background-color: rgba(243, 241, 236, 0.18);
    transition-property: width, background-color;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out-cubic, ease-out;
}
.ss-bar.hover .ss-thumb { width: 8px; background-color: rgba(243, 241, 236, 0.36); }
.ss-bar.dragging .ss-thumb { width: 8px; background-color: #FF4B3A; }
