/*
 * 编辑器右侧的侧边面板（多人制谱等）。风格和设置窗口一致（方正扁平、红色强调），但底色半透明，占屏幕右半边、几乎整个高度。
 * 整块 sp-dock = [把手][窗口] 贴在屏幕右边；收起时整体右移一个窗口宽（1040 + 右边距 24），只露出把手。
 * 不在编辑器里时加 gone：连把手一起滑出屏幕并淡出。
 */

.sp-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 窗口 1040×900：参考分辨率按高度 1080 缩放，top 70 → 底边在 970，正好停在编辑器右下角那排按钮上面 */
.sp-dock {
    position: absolute;
    right: 0;
    top: 70px;
    flex-direction: row;
    align-items: center;
    translate: 1064px 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.55s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out;
}
.sp-dock.open { translate: 0 0; }
.sp-dock.gone { opacity: 0; translate: 1160px 0; }

/* ---------------------------------------------------------------- 把手：左半边圆角矩形 + 小三角 */

.sp-handle {
    width: 46px;
    height: 132px;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 8, 13, 0.82);
    border-width: 1px;
    border-right-width: 0;
    border-color: rgba(243, 241, 236, 0.18);
    border-top-left-radius: 18px;
    border-bottom-left-radius: 18px;
    transition-property: width, background-color, border-color;
    transition-duration: 0.3s, 0.2s, 0.2s;
    transition-timing-function: ease-out-back, ease-out, ease-out;
}
.sp-handle:hover { width: 58px; background-color: rgba(30, 32, 42, 0.9); border-color: rgba(255, 75, 58, 0.7); }
.sp-handle:active { background-color: rgba(255, 75, 58, 0.85); }

/* 收起时三角朝左（点了往左拉出来），展开后转回朝右 */
.sp-handle-icon {
    rotate: 180deg;
    -unity-background-image-tint-color: rgba(243, 241, 236, 0.8);
    transition-property: rotate, -unity-background-image-tint-color, translate;
    transition-duration: 0.55s, 0.2s, 0.3s;
    transition-timing-function: ease-out-back, ease-out, ease-out-back;
}
.sp-handle:hover .sp-handle-icon { -unity-background-image-tint-color: #F3F1EC; translate: -3px 0; }
.sp-dock.open .sp-handle-icon { rotate: 0deg; }
.sp-dock.open .sp-handle:hover .sp-handle-icon { translate: 3px 0; }

/* 需要注意（比如客人要选谱面放哪）：把手一闪一闪变红 */
.sp-handle.attention { background-color: rgba(255, 75, 58, 0.9); border-color: #FF4B3A; }
.sp-handle.attention .sp-handle-icon { -unity-background-image-tint-color: #FFFFFF; }

/* 在房间里：把手上亮一个小绿点 */
.sp-handle-dot {
    position: absolute;
    top: 14px;
    width: 8px; height: 8px;
    border-radius: 4px;
    background-color: #6FE3A0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}
.sp-handle.live .sp-handle-dot { opacity: 1; }

/* ---------------------------------------------------------------- 窗口 */

.sp-window {
    width: 1040px;
    height: 900px;
    margin-right: 24px;
    background-color: rgba(7, 8, 13, 0.84);
    border-width: 1px;
    border-top-width: 3px;
    border-color: rgba(243, 241, 236, 0.16);
    border-top-color: #FF4B3A;
}

.sp-head {
    height: 92px;
    flex-direction: row;
    align-items: center;
    padding: 0 22px 0 28px;
    border-bottom-width: 1px;
    border-color: rgba(243, 241, 236, 0.14);
}
.sp-logo { width: 44px; height: 44px; margin-right: 18px; }
.sp-titles { flex-shrink: 0; }
.sp-title { font-size: 38px; -unity-font-style: bold; }
.sp-tag { font-size: 12px; letter-spacing: 7px; color: rgba(243, 241, 236, 0.36); margin-top: 1px; }

/* 顶栏右边的状态小牌子：点的颜色表示状态，有动静时跳一下 */
.sp-chip {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 16px;
    margin-right: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(243, 241, 236, 0.14);
}
.sp-chip-dot {
    width: 8px; height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    background-color: rgba(243, 241, 236, 0.36);
    transition-property: background-color, scale;
    transition-duration: 0.3s, 0.4s;
    transition-timing-function: ease-out, ease-out-back;
}
.sp-chip.good .sp-chip-dot { background-color: #6FE3A0; }
.sp-chip.busy .sp-chip-dot { background-color: #FFC24B; }
.sp-chip.warn .sp-chip-dot { background-color: #FF4B3A; }
.sp-chip.beat .sp-chip-dot { scale: 1.7 1.7; }
.sp-chip-label { font-size: 17px; color: rgba(243, 241, 236, 0.8); }

/* 收起按钮（和设置窗口的 × 同样的方块） */
.sp-close {
    width: 52px; height: 52px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.2s;
    transition-timing-function: ease-out, ease-out-back;
}
.sp-close:hover { background-color: #FF4B3A; }
.sp-close:hover .ic { -unity-background-image-tint-color: #FFFFFF; translate: 3px 0; }
.sp-close:active { scale: 0.88 0.88; }

/* ---------------------------------------------------------------- 主体：左边栏 + 页面 */

.sp-body { flex-grow: 1; flex-direction: row; }
.sp-side {
    width: 230px;
    padding: 20px 14px 0 20px;
    border-right-width: 1px;
    border-color: rgba(243, 241, 236, 0.08);
}
.sp-side .cat { padding-left: 16px; }
.sp-side .cat-name { font-size: 23px; }
.sp-page { flex-grow: 1; padding-top: 12px; }
.sp-page .st-label { font-size: 22px; }
.sp-page .st-hint-text { font-size: 15px; }
.sp-page .st-row { min-height: 68px; }

/* 收起的行要真的收起来：上面给 .sp-page .st-row 设了 min-height，这里优先级更高才能把它压回 0（之前中间那段空白就是这个） */
.sp-page .st-row.collapsed { min-height: 0; }

/* ---------------------------------------------------------------- 顶栏：参与者头像 */

.sp-avatars { flex-direction: row; align-items: center; margin-right: 16px; }
.av-stack { flex-direction: row-reverse; align-items: center; }
.av {
    width: 42px; height: 42px;
    margin-left: -10px;
    border-radius: 21px;
    border-width: 2px;
    border-color: rgba(7, 8, 13, 0.95);
    background-color: rgba(255, 255, 255, 0.14);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale, translate, border-color;
    transition-duration: 0.3s, 0.45s, 0.3s, 0.2s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out;
}
.av.in { opacity: 1; scale: 1 1; }
.av.host { border-color: #FF4B3A; }
.av:hover { scale: 1.18 1.18; translate: 0 -2px; border-color: #F3F1EC; }
.av-initial { font-size: 18px; -unity-font-style: bold; color: #F3F1EC; }
.av-badge {
    position: absolute;
    bottom: -7px;
    padding: 0 4px;
    font-size: 10px;
    color: #FFFFFF;
    background-color: #FF4B3A;
}

/* 悬停提示：小黑条，出现在目标下方居中 */
.tip {
    position: absolute;
    padding: 6px 12px;
    font-size: 16px;
    color: #F3F1EC;
    background-color: rgba(7, 8, 13, 0.96);
    border-width: 1px;
    border-color: rgba(243, 241, 236, 0.2);
    border-top-color: #FF4B3A;
    translate: -50% 6px;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.15s, 0.25s;
    transition-timing-function: ease-out, ease-out-cubic;
}
.tip.show { opacity: 1; translate: -50% 0; }

/* ---------------------------------------------------------------- 当前谱面卡片 */

.lv-card {
    flex-direction: row;
    padding: 16px;
    margin: 4px 0 14px 0;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 3px;
    border-color: #4B6BFF;
    transition-property: opacity, translate;
    transition-duration: 0.4s, 0.5s;
    transition-timing-function: ease-out, ease-out-cubic;
}
.lv-card.hidden { opacity: 0; translate: 0 20px; }
.lv-cover {
    width: 128px; height: 128px;
    flex-shrink: 0;
    margin-right: 20px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.07);
    -unity-background-scale-mode: scale-and-crop;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.4s;
}
.lv-cover.flash { opacity: 0.2; }
.lv-cover-icon { width: 48px; height: 48px; -unity-background-image-tint-color: rgba(243, 241, 236, 0.3); }
.lv-text { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.lv-title { font-size: 28px; -unity-font-style: bold; white-space: normal; }
.lv-subtitle { font-size: 16px; color: rgba(243, 241, 236, 0.62); margin-top: 2px; white-space: normal; }
.lv-stats { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.lv-stat {
    flex-direction: row;
    align-items: flex-end;
    padding: 4px 12px;
    margin: 0 8px 6px 0;
    background-color: rgba(255, 255, 255, 0.07);
}
.lv-stat-value { font-size: 20px; -unity-font-style: bold; scale: 1 1; transition-property: scale, color; transition-duration: 0.3s, 0.3s; transition-timing-function: ease-out-back, ease-out; }
.lv-stat-value.bump { scale: 1.25 1.25; color: #FF4B3A; }
.lv-stat-name { font-size: 13px; color: rgba(243, 241, 236, 0.45); margin-left: 6px; margin-bottom: 2px; }
.lv-path { font-size: 13px; color: rgba(243, 241, 236, 0.3); margin-top: 4px; white-space: normal; }

/* ---------------------------------------------------------------- 修改记录 */

.feed { flex-grow: 1; transition-property: opacity, translate; transition-duration: 0.4s, 0.5s; transition-timing-function: ease-out, ease-out-cubic; }
.feed.hidden { opacity: 0; translate: 0 20px; }
.feed-scroll { flex-grow: 1; }
.feed-row {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
    padding: 8px 16px 8px 14px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, opacity, translate;
    transition-duration: 0.15s, 0.15s, 0.35s, 0.45s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out-back;
}
.feed-row.enter { opacity: 0; translate: 0 -24px; }
.feed-row.link:hover { background-color: rgba(255, 255, 255, 0.1); border-color: #FF4B3A; }
.feed-av {
    width: 34px; height: 34px;
    flex-shrink: 0;
    border-radius: 17px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.14);
    -unity-background-scale-mode: scale-and-crop;
}
.feed-av-initial { font-size: 15px; -unity-font-style: bold; }
.feed-icon { margin-right: 12px; -unity-background-image-tint-color: rgba(243, 241, 236, 0.45); }
.feed-row.link:hover .feed-icon { -unity-background-image-tint-color: #FF4B3A; }
.feed-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.feed-who { font-size: 14px; color: rgba(243, 241, 236, 0.5); }
.feed-what { font-size: 18px; white-space: normal; }
.feed-time { font-size: 13px; color: rgba(243, 241, 236, 0.36); margin-left: 12px; flex-shrink: 0; }
.feed-go { margin-left: 8px; opacity: 0.3; }
.feed-row.link:hover .feed-go { opacity: 1; translate: 3px 0; }
.feed-empty {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 0 80px;
}
.feed-empty .ic { width: 56px; height: 56px; -unity-background-image-tint-color: rgba(243, 241, 236, 0.2); margin-bottom: 14px; }
.feed-empty-title { font-size: 22px; color: rgba(243, 241, 236, 0.6); }
.feed-empty-hint { font-size: 15px; color: rgba(243, 241, 236, 0.32); margin-top: 6px; white-space: normal; -unity-text-align: middle-center; }
